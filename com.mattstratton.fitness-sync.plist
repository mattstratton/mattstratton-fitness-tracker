<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mattstratton.fitness-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/make</string>
        <string>-C</string>
        <string>/Users/mattstratton/src/github.com/mattstratton/mattstratton-fitness-tracker</string>
        <string>sync</string>
    </array>
    <!-- Run whenever a new HAE export lands in iCloud (whenever the phone
         gets around to exporting), plus once daily for the Liftosaur pull. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/mattstratton/Library/Mobile Documents/com~apple~CloudDocs/AutoExport</string>
        <string>/Users/mattstratton/Library/Mobile Documents/com~apple~CloudDocs/HealthExport</string>
    </array>
    <!-- WatchPaths is not recursive, so it can miss files created inside
         AutoExport/{automation_name}/ subfolders; the hourly timer is the
         reliable backstop (sync is a no-op when nothing is new). -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/mattstratton/src/github.com/mattstratton/mattstratton-fitness-tracker/logs/sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mattstratton/src/github.com/mattstratton/mattstratton-fitness-tracker/logs/sync.log</string>
</dict>
</plist>
