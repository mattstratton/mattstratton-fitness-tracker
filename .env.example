# Tiger Cloud. Use the POOLED connection string if the service has a pooler;
# serverless functions scale horizontally and a direct connection per instance
# will exhaust a small service. Keep sslmode=verify-full.
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=verify-full

# Liftosaur app -> Settings -> API Keys (requires premium)
LIFTOSAUR_API_KEY=lftsk_...

# Shared secret Health Auto Export sends as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
HAE_INGEST_TOKEN=

# Vercel sends this on scheduled cron invocations. Set it in the Vercel project
# and the cron routes will reject anything else. Without it they refuse ALL
# requests rather than running unauthenticated.
CRON_SECRET=
