{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Node strips types at runtime rather than compiling, so syntax that needs
    // a real emit step (enums, namespaces, parameter properties) is banned.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["api/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
